<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zepocas.skhd</string>
    <key>ProgramArguments</key>
    <array>
        <string>@SKHD@</string>
        <string>-c</string>
        <string>@SKHD_CONFIG@</string>
    </array>
    <!-- skhd runs its bindings through a shell; give it the PATH that has komorebic. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>KOMOREBI_CONFIG_HOME</key>
        <string>@CONFIG_DIR@</string>
        <key>PATH</key>
        <string>@PATH@</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/skhd.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/skhd.log</string>
</dict>
</plist>
